# Operator details for the Dutch legal pages (/privacy, /voorwaarden) and the footer contact link.
# Read at build time: copy to .env.local, or set them as build variables in your CI.
# Leave VITE_LEGAL_NAME or VITE_LEGAL_EMAIL empty to leave out the legal pages, the consent
# notice under the connect button and the contact link (e.g. for personal use).
VITE_LEGAL_NAME=
VITE_LEGAL_EMAIL=
# Optional
VITE_LEGAL_STREET=
# Postcode and city, e.g. 1234 AB Amsterdam
VITE_LEGAL_CITY=
VITE_LEGAL_KVK=
# Court city for disputes, e.g. Amsterdam (otherwise "de bevoegde Nederlandse rechter")
VITE_LEGAL_COURT=
